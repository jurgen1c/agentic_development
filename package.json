{
  "name": "@jurgen1c/agentic-development",
  "version": "0.1.0",
  "description": "Integration package for Jurgen's standalone Agent Memory and Agent Flow tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jurgen1c/agentic_development.git"
  },
  "keywords": [
    "agent",
    "memory",
    "workflow",
    "integration"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./memory-flow-adapter": {
      "types": "./dist/memory-flow-adapter.d.ts",
      "import": "./dist/memory-flow-adapter.js",
      "default": "./dist/memory-flow-adapter.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "audit": "bun audit --audit-level moderate",
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build src/index.ts src/memory-flow-adapter.ts --target=node --packages=external --outdir=dist",
    "build:types": "tsc -p tsconfig.build.json",
    "ci": "bun run audit && bun test && bun run lint && bun run typecheck && bun run build",
    "lint": "eslint .",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@jurgen1c/agent-flow": "^0.1.0",
    "@jurgen1c/agent-memory-cli": "^0.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.1",
    "eslint": "^10.5.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.62.0"
  },
  "engines": {
    "node": ">=25.9.0"
  }
}
